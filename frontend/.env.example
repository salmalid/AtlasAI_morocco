# Backend origin, as the BROWSER will reach it.
#
# When set, the browser calls the API directly (CORS is configured for
# localhost:3000). When unset, requests fall back to a same-origin /api/* path
# that the Next server proxies.
#
# Direct is the default because the dev proxy imposes its own socket timeout,
# and an analysis that outlives it surfaces as a generic 500 with the real
# cause buried in the Next server log.
NEXT_PUBLIC_API_URL=http://localhost:8000

# CARTO basemap API key — removes the watermark and raises the rate limit
# to 5 million tile requests/month for free.
# Get your key at: https://carto.com/basemaps/
NEXT_PUBLIC_CARTO_KEY=

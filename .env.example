# ---------------------------------------------------------------------------
# AtlasAI Morocco — environment configuration
# Copy to `.env` and adjust. Every value below has a working default; the
# platform starts and serves real satellite analysis with none of them set.
# ---------------------------------------------------------------------------

# --- API ---------------------------------------------------------------------
ATLASAI_API_HOST=0.0.0.0
ATLASAI_API_PORT=8000
ATLASAI_LOG_LEVEL=INFO
ATLASAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Earth Observation catalog ------------------------------------------------
# This is a PUBLIC ENDPOINT, not a credential. There is nothing to sign up for
# and nothing to paste — the platform reads live Sentinel, Landsat, MODIS and
# DEM data through it anonymously. Leave it as-is.
ATLASAI_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# Entirely optional. Anonymous access works; a key only raises the rate limit,
# which matters once you are running many analyses in quick succession.
# Free, no card: https://planetarycomputer.developer.azure-api.net/
ATLASAI_PC_SUBSCRIPTION_KEY=

# Max pixels fetched per analysis request (guards against huge AOIs).
ATLASAI_MAX_PIXELS=4000000
ATLASAI_DEFAULT_RESOLUTION=20

# --- Cache --------------------------------------------------------------------
ATLASAI_CACHE_DIR=.cache
ATLASAI_CACHE_TTL_SECONDS=86400

# --- Database (optional) ------------------------------------------------------
# Leave empty to run without persistence. `docker compose up` sets this for you.
ATLASAI_DATABASE_URL=
# ATLASAI_DATABASE_URL=postgresql+psycopg://atlasai:atlasai@localhost:5432/atlasai

# --- AI assistant (optional) --------------------------------------------------
# Without a key the assistant uses its built-in deterministic intent router.
# With a key it uses Gemini to plan which analysis modules to run.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
ATLASAI_ASSISTANT_MODEL=gemini-2.0-flash

# --- Neural backends (optional) -----------------------------------------------
# Directory holding trained segmentation weights. See docs/MODELS.md.
ATLASAI_MODEL_DIR=models
ATLASAI_TORCH_DEVICE=auto

# --- Frontend -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
